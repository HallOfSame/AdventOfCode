@using Helpers.Structure
@using Helpers.Interfaces
@using Heron.MudCalendar

<MudCalendar T="PuzzleCalendarItem"
             Items="puzzles"
             ItemClicked="ItemClicked"
             CurrentDay="new DateTime(2025, 12, 1)"
             ShowToolbar="@false">
    <CellTemplate>
        <div style="width: 85%; height: 100%; border: 2px solid var(--mud-palette-primary); margin: 15px auto 0 auto;">
            <div style="background-color: var(--mud-palette-primary);">
                <MudText Style="color: #ffffff;" Typo="Typo.body1" Align="Align.Center">@(context.PuzzleInfo.Name)</MudText>
            </div>
        </div>
    </CellTemplate>
</MudCalendar>

@inject IEnumerable<IPuzzle> Puzzles
@inject NavigationManager NavigationManager
@code {
    private PuzzleCalendarItem[] puzzles = [];

    protected override void OnInitialized()
    {
        puzzles = Puzzles.Select(x =>
            {
                var date = new DateTime(x.Info.Year, 12, x.Info.Day);

                return new PuzzleCalendarItem
                {
                    PuzzleInfo = x.Info,
                    Start = date,
                    End = date.AddDays(1).AddTicks(-1),
                    AllDay = true,
                    Text = x.Info.Name
                };
            })
            .ToArray();
        base.OnInitialized();
    }

    private void ItemClicked(PuzzleCalendarItem item)
    {
        GoToPuzzle(item.PuzzleInfo);
    }

    private void GoToPuzzle(PuzzleInfo puzzle)
    {
        NavigationManager.NavigateTo($"puzzle/{puzzle.Year}/{puzzle.Day}");
    }

    class PuzzleCalendarItem : CalendarItem
    {
        public required PuzzleInfo PuzzleInfo { get; init; }
    }
}
