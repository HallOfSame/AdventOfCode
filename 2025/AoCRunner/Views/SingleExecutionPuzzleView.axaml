<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:AoCRunner.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AoCRunner.Views.SingleExecutionPuzzleView"
             x:DataType="viewModels:SingleExecutionPuzzleViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   HorizontalAlignment="Center"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0 10"
                   Text="{Binding Title}" />
        <Grid ColumnDefinitions="*, 2*" 
              RowDefinitions="*"
              Margin="10">
            <TextBox Grid.Column="1" 
                     Watermark="Input" 
                     AcceptsReturn="True"
                     Margin="20 0 0 0"
                     Text="{Binding Input}" />
            <Grid Grid.Column="0"
                  RowDefinitions="Auto, Auto, *">
                <StackPanel Grid.Row="0"
                            Spacing="10"
                            Orientation="Horizontal">
                    <Button Command="{Binding RunPartOne}">Run Part One</Button>
                    <Button Command="{Binding RunPartTwo}">Run Part Two</Button>
                </StackPanel>
                <Label Grid.Row="1">Execution Output:</Label>
                <Border Grid.Row="2"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Progress}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <SelectableTextBlock Text="{Binding Text}"
                                                         Foreground="{Binding Type, Converter={StaticResource MessageTypeToBrushConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
